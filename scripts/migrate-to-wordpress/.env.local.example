VITE_SUPABASE_URL="https://yizbdceusxhyofdgkfhg.supabase.co"

# Supabase dashboard -> Project Settings -> API -> "service_role" secret.
# NOT the anon key already in the app's root .env. This key bypasses Row Level
# Security, so keep this file local only (it's gitignored) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=""

WP_ADMIN_USER="admin"

# Optional: leave blank and the script will read
# docker/wordpress/scripts/.app-password automatically after `npm run wp:bootstrap`.
WP_APPLICATION_PASSWORD=""

WPGRAPHQL_ENDPOINT="http://localhost:8090/graphql"
WP_REST_ENDPOINT="http://localhost:8090/wp-json"
